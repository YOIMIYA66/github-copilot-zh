  "cards": [
    {
      "dot": "emerald",
      "title": "无损注入与非破坏性架构",
      "items": [
        "零文件修改：不修改 github.exe 或 app.asar 二进制文件",
        "标准调试管道：基于 Chrome DevTools Protocol 注入运行时观察脚本",
        "热插拔退场：Ctrl+C 或关闭应用即彻底卸载，还原纯净环境"
      ]
    },
    {
      "dot": "rose",
      "title": "双重进程链与签名审计",
      "items": [
        "签名证书校验：严格验证 GitHub, Inc. 与 Microsoft Corporation 签名",
        "网络边界隔离：强制锁定 127.0.0.1 本地回环与动态独占端口",
        "进程树关系判定：递归审计 WebView2 是否属于目标 Copilot 派生子进程"
      ]
    },
    {
      "dot": "cyan",
      "title": "DOM 响应式汉化引擎",
      "items": [
        "智能 MutationObserver：监听 DOM 子树增量变动，毫秒级局部补丁",
        "双向映射防抖：避免替换后重复触发观察器导致无限循环",
        "全量覆盖：深度支持设置界面、侧边栏菜单及 Composer 交互面板"
      ]
    }
  ]
